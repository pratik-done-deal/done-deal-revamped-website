VITE_CDN_BASE_URL=https://cdn.done.deals

# PostHog analytics — project API key and ingestion host.
# Leave VITE_POSTHOG_KEY unset to disable tracking entirely (e.g. local dev).
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Console-logs every tracked event's name + properties. Keep off in production.
VITE_POSTHOG_DEBUG=true
